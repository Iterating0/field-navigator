# Copy to .env in the project root. Keys stay on the backend.
# OpenAlex anonymous usage is limited; a free key is recommended.
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Any provider implementing the OpenAI-compatible Chat Completions protocol.
# Without LLM_API_KEY, curated NHSE decomposition is used and clearly labeled.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# auto negotiates json_schema -> json_object only when the format is unsupported.
# Or force json_schema (strict) / json_object. All results are validated locally.
LLM_RESPONSE_FORMAT=auto
# auto disables thinking on the official DeepSeek endpoint; other providers keep their defaults.
# provider = unchanged; disabled / low / high explicitly use DeepSeek-compatible thinking parameters.
LLM_THINKING=auto
# Completion budget, including reasoning when enabled. Truncated JSON is never cached.
LLM_MAX_TOKENS=16384
# Experimental representative shortlist: 0 = all retrieved papers; try 16 after quality review.
# Effective limit is never below CORE_PAPER_LIMIT.
LLM_ANALYSIS_LIMIT=0

DATABASE_PATH=backend/data/field_navigator.sqlite3
CACHE_TTL_HOURS=168
SEARCH_CACHE_TTL_HOURS=24
SEARCH_LIMIT=40
CORE_PAPER_LIMIT=8
REQUEST_TIMEOUT_SECONDS=45
# Model analysis of many abstracts may take longer than paper search.
LLM_REQUEST_TIMEOUT_SECONDS=180

# Optional built frontend for a single-container deployment; keep blank for Vite development.
FRONTEND_DIST_PATH=
# 0 = unlimited local use. The ModelScope Docker image defaults to 30 attempts / 2 active.
# Limits apply per process to non-cached auto/live requests; offline demos remain available.
LIVE_REQUEST_BUDGET=0
LIVE_MAX_CONCURRENCY=0

# Available features are reweighted when some signals are missing.
RANK_CITATION=0.20
RANK_AGE_NORMALIZED=0.15
RANK_RELEVANCE=0.30
RANK_SHARED_REFERENCES=0.10
RANK_LLM_IMPORTANCE=0.25
